{
  "config": {
    "bases": {
      "api": "https://api.example.com/v2/"
    },
    "headers": {
      "Content-Type": "application/json; charset=UTF-8"
    },
    "default_body": {
      "lang": "{{lang}}"
    }
  },
  "setup": [
    {
      "name": "ensure_config",
      "steps": [
        {
          "type": "http_post",
          "base": "api",
          "path": "public/config/",
          "body": "{}"
        },
        {
          "type": "extract_state",
          "mapping": {
            "serverToken": "token"
          }
        }
      ]
    }
  ],
  "actions": {
    "get_home": {
      "requires": [
        "ensure_config"
      ],
      "steps": [
        {
          "type": "http_post",
          "base": "api",
          "path": "home/",
          "body": {
            "page": 1
          }
        },
        {
          "type": "parse_home_sections",
          "sections": [
            {
              "id": "popular",
              "layout": "grid_3",
              "source": "popular"
            },
            {
              "id": "recent",
              "layout": "carousel_big",
              "source": "recent"
            }
          ]
        }
      ]
    },
    "get_feed": {
      "requires": [
        "ensure_config"
      ],
      "steps": [
        {
          "type": "switch",
          "expression": "{{type}}",
          "cases": {
            "latest": "recent/",
            "for_you": "for_you/"
          },
          "default": "popular/",
          "store_as": "endpoint"
        },
        {
          "type": "http_post",
          "base": "api",
          "path": "{{state.endpoint}}",
          "body": {
            "page": "{{page}}",
            "size": 20
          }
        },
        {
          "type": "parse_list",
          "root": "list",
          "using_mapper": "manga_item"
        }
      ]
    },
    "search": {
      "requires": [
        "ensure_config"
      ],
      "steps": [
        {
          "type": "http_post",
          "base": "api",
          "path": "search/",
          "body": {
            "q": "{{keyword}}",
            "page": "{{page}}"
          }
        },
        {
          "type": "parse_list",
          "root": "results",
          "using_mapper": "manga_item"
        }
      ]
    },
    "get_manga_details": {
      "requires": [
        "ensure_config"
      ],
      "steps": [
        {
          "type": "http_post",
          "base": "api",
          "path": "manga/",
          "body": {
            "id": "{{mangaId}}"
          }
        },
        {
          "type": "parse_object",
          "root": "manga",
          "using_mapper": "manga_item"
        }
      ]
    },
    "get_chapters": {
      "requires": [
        "ensure_config"
      ],
      "steps": [
        {
          "type": "http_post",
          "base": "api",
          "path": "manga/chapters/",
          "body": {
            "id": "{{mangaId}}"
          }
        },
        {
          "type": "parse_list",
          "root": "list",
          "mapping": {
            "id": "chapter_id",
            "number": "number",
            "title": "title",
            "url": "url",
            "date": "date",
            "isNew": "is_new"
          }
        }
      ]
    },
    "get_chapter_pages": {
      "requires": [
        "ensure_config"
      ],
      "steps": [
        {
          "type": "http_post",
          "base": "api",
          "path": "chapter/pages/",
          "body": {
            "id": "{{chapterId}}"
          }
        },
        {
          "type": "parse_list",
          "root": "pages",
          "mapping": {
            "imageUrl": "img",
            "width": "w",
            "height": "h",
            "index": "order"
          }
        }
      ]
    },
    "get_recommendations": {
      "requires": [
        "ensure_config"
      ],
      "steps": [
        {
          "type": "http_post",
          "base": "api",
          "path": "manga/similar/",
          "body": {
            "id": "{{mangaId}}",
            "num": "{{num}}"
          }
        },
        {
          "type": "parse_list",
          "root": "list",
          "using_mapper": "manga_item"
        }
      ]
    },
    "get_catalog": {
      "requires": [
        "ensure_config"
      ],
      "steps": [
        {
          "type": "http_post",
          "base": "api",
          "path": "catalog/",
          "body": {
            "page": "{{page}}"
          }
        },
        {
          "type": "parse_list",
          "root": "list",
          "using_mapper": "manga_item"
        }
      ]
    }
  },
  "mappers": {
    "manga_item": {
      "id": [
        "id",
        "manga_id"
      ],
      "title": [
        "title",
        "name"
      ],
      "coverUrl": [
        "cover",
        "cover"
      ],
      "description": [
        "summary",
        "description"
      ],
      "author": "author",
      "lastChapter": "last_chapter",
      "rate": "score"
    }
  }
}
