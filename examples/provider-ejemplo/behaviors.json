{
  "config": {
    "bases": { "api": "https://api.ejemplo-ficticio.com/v2/" },
    "headers": { "Content-Type": "application/json; charset=UTF-8" },
    "default_body": { "lang": "{{lang}}" }
  },
  "setup": [
    {
      "name": "ensure_config",
      "steps": [
        { "type": "http_post", "base": "api", "path": "public/config/",
          "body": "{}" },
        { "type": "extract_state", "mapping": { "serverToken": "token" } }
      ]
    }
  ],
  "actions": {
    "get_home": {
      "requires": ["ensure_config"],
      "steps": [
        { "type": "http_post", "base": "api", "path": "home/",
          "body": { "page": 1 } },
        { "type": "parse_home_sections", "sections": [
            { "id": "populares", "layout": "grid_3", "source": "populares" },
            { "id": "recientes", "layout": "carousel_big", "source": "recientes" }
        ] }
      ]
    },
    "get_feed": {
      "requires": ["ensure_config"],
      "steps": [
        { "type": "switch", "expression": "{{type}}",
          "cases": { "latest": "recientes/", "for_you": "para_ti/" },
          "default": "populares/", "store_as": "endpoint" },
        { "type": "http_post", "base": "api", "path": "{{state.endpoint}}",
          "body": { "page": "{{page}}", "size": 20 } },
        { "type": "parse_list", "root": "list", "using_mapper": "manga_item" }
      ]
    },
    "search": {
      "requires": ["ensure_config"],
      "steps": [
        { "type": "http_post", "base": "api", "path": "buscar/",
          "body": { "q": "{{keyword}}", "page": "{{page}}" } },
        { "type": "parse_list", "root": "results", "using_mapper": "manga_item" }
      ]
    },
    "get_manga_details": {
      "requires": ["ensure_config"],
      "steps": [
        { "type": "http_post", "base": "api", "path": "manga/",
          "body": { "id": "{{mangaId}}" } },
        { "type": "parse_object", "root": "manga", "using_mapper": "manga_item" }
      ]
    },
    "get_chapters": {
      "requires": ["ensure_config"],
      "steps": [
        { "type": "http_post", "base": "api", "path": "manga/capitulos/",
          "body": { "id": "{{mangaId}}" } },
        { "type": "parse_list", "root": "list",
          "mapping": {
            "id": "chapter_id", "number": "numero", "title": "titulo",
            "url": "url", "date": "fecha", "isNew": "nuevo" } }
      ]
    },
    "get_chapter_pages": {
      "requires": ["ensure_config"],
      "steps": [
        { "type": "http_post", "base": "api", "path": "capitulo/paginas/",
          "body": { "id": "{{chapterId}}" } },
        { "type": "parse_list", "root": "pages",
          "mapping": { "imageUrl": "img", "width": "w", "height": "h",
                       "index": "orden" } }
      ]
    },
    "get_recommendations": {
      "requires": ["ensure_config"],
      "steps": [
        { "type": "http_post", "base": "api", "path": "manga/similares/",
          "body": { "id": "{{mangaId}}", "num": "{{num}}" } },
        { "type": "parse_list", "root": "list", "using_mapper": "manga_item" }
      ]
    },
    "get_catalog": {
      "requires": ["ensure_config"],
      "steps": [
        { "type": "http_post", "base": "api", "path": "catalogo/",
          "body": { "page": "{{page}}" } },
        { "type": "parse_list", "root": "list", "using_mapper": "manga_item" }
      ]
    }
  },
  "mappers": {
    "manga_item": {
      "id": ["id", "manga_id"],
      "title": ["titulo", "name"],
      "coverUrl": ["portada", "cover"],
      "description": ["sinopsis", "description"],
      "author": "autor",
      "lastChapter": "ultimo_capitulo",
      "rate": "puntaje"
    }
  }
}
